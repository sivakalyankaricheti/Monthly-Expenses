{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monthly-expenses",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
